# Task Management System - Backend Environment Configuration Template
# Copy this file to a new file named `.env` in the same directory and fill in your values.

# Database URL connection string (Direct or Pooled)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/tms_dev_db?schema=public"

# Secret key used for signing JWT Session tokens (Make it a secure random string in production)
JWT_SECRET="your-jwt-secret-key-change-me-in-production"

# Port the backend API server will run on (Default: 3000)
PORT=3000
