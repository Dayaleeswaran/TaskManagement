# Task Management System - Backend Environment Configuration Template
# Copy this file to a new file named `.env` in the same directory and fill in your values.

# 1. NODE_ENV - Defines the runtime environment mode (development, production, staging, or test)
# In production, set to 'production' to enable optimizations, secure logging, and strict CORS.
NODE_ENV=development

# 2. PORT - The port the Express backend server listens on.
# Render and other cloud hosts will override this with their own host PORT environment variable.
PORT=3000

# 3. DATABASE_URL - PostgreSQL connection URI.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# Use connection pooling if available in production (e.g. pgBouncer).
DATABASE_URL="postgresql://postgres:password123@localhost:5432/tms_dev_db?schema=public"

# 4. JWT_SECRET - Secret key used for signing and verifying JWT authentication tokens.
# WARNING: Always change this in staging and production to a strong, cryptographically secure random string.
JWT_SECRET="your-jwt-secret-key-change-me-in-production"

# 5. JWT_EXPIRES_IN - Token expiration duration (e.g., 24h, 7d).
JWT_EXPIRES_IN="24h"

# 6. CLIENT_ORIGIN - Allowed frontend origin(s) for CORS.
# For multiple origins in production, separate them with commas (no spaces), e.g., https://tms.vercel.app,https://admin.tms.vercel.app
CLIENT_ORIGIN="http://localhost:5173"
