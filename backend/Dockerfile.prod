# Stage 1: Install dependencies and generate Prisma client
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install dependencies (including devDependencies for Prisma generate)
RUN npm ci

# Copy application source and configuration
COPY . .

# Generate Prisma Client code based on database schema
RUN npx prisma generate

# Stage 2: Build the production runner image
FROM node:20-alpine AS runner

WORKDIR /app

# Set node environment to production
ENV NODE_ENV=production

# Copy package descriptors and node_modules from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

# Copy only the necessary runtime files (source and prisma schema/seeds)
COPY --from=builder /app/src ./src
COPY --from=builder /app/prisma ./prisma

# Expose backend API port
EXPOSE 3000

# Start the application in production mode
CMD ["npm", "run", "start"]

