                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure we use active collaborator token or fallback to admin",
                  "var token = pm.collectionVariables.get(\"collabToken\") || pm.collectionVariables.get(\"adminToken\");",
