# ==========================================
# Stage 1: Build the React + Vite Frontend
# ==========================================
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first for caching benefits
COPY package*.json ./
RUN npm ci

# Copy application source code
COPY . .

# Set up build arguments for Vite environment variables
# Vite requires these at build time to embed them in the static files
ARG VITE_API_URL
ARG VITE_SOCKET_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL

# Build the static single-page application
RUN npm run build

# ==========================================
# Stage 2: Serve with Nginx Reverse Proxy
# ==========================================
FROM nginx:1.25-alpine

# Copy built static assets from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Replace default nginx configuration with our custom production reverse proxy config
COPY nginx.conf /etc/nginx/nginx.conf

# Expose HTTP port 80
EXPOSE 80

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
