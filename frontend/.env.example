# Task Management System - Frontend Environment Configuration Template
# Copy this file to a new file named `.env` in the same directory and fill in your values.

# 1. VITE_API_URL - The base HTTP URL of the backend API service.
# For local dev: http://localhost:3000
# For production: The URL of your deployed backend service (e.g., https://api-tms.render.com)
VITE_API_URL="http://localhost:3000"

# 2. VITE_SOCKET_URL - The base WebSocket URL of the backend Socket.io server.
# For local dev: http://localhost:3000
# For production: The URL of your deployed backend service (e.g., https://api-tms.render.com)
VITE_SOCKET_URL="http://localhost:3000"
